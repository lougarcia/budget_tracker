---
import Layout from '../../../layouts/Layout.astro';
import { userPreferences } from '../../../db/schema';
import { eq } from 'drizzle-orm';

const db = Astro.locals.db;
const user = Astro.locals.user!;

const [preferences] = await db
  .select()
  .from(userPreferences)
  .where(eq(userPreferences.userId, user.id))
  .limit(1);

const defaultCurrency = preferences?.defaultCurrency || 'USD';
---
<Layout title="Settings">
  <div class="max-w-2xl mx-auto space-y-8">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900">Settings</h1>
      <p class="text-slate-600 mt-1">Manage your account settings and preferences.</p>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-6">
      <h2 class="text-xl font-bold text-slate-900 mb-4">Profile</h2>
      <form id="profile-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Name</label>
          <input
            type="text"
            name="name"
            value={user.name}
            required
            class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Email</label>
          <input
            type="email"
            value={user.email}
            disabled
            class="w-full px-3 py-2 border border-slate-200 rounded-lg bg-slate-50 text-slate-500"
          />
          <p class="text-xs text-slate-500 mt-1">Email cannot be changed.</p>
        </div>
        <div id="profile-success" class="text-sm text-green-600 hidden"></div>
        <div id="profile-error" class="text-sm text-red-600 hidden"></div>
        <div class="flex justify-end">
          <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium">
            Update Profile
          </button>
        </div>
      </form>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-6">
      <h2 class="text-xl font-bold text-slate-900 mb-4">Change Password</h2>
      <form id="password-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Current Password</label>
          <input
            type="password"
            name="currentPassword"
            required
            class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">New Password</label>
          <input
            type="password"
            name="newPassword"
            required
            minlength="6"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          />
          <p class="text-xs text-slate-500 mt-1">Must be at least 6 characters.</p>
        </div>
        <div id="password-success" class="text-sm text-green-600 hidden"></div>
        <div id="password-error" class="text-sm text-red-600 hidden"></div>
        <div class="flex justify-end">
          <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium">
            Change Password
          </button>
        </div>
      </form>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-6">
      <h2 class="text-xl font-bold text-slate-900 mb-4">Preferences</h2>
      <form id="preferences-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Default Currency</label>
          <select
            name="defaultCurrency"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          >
            <option value="USD" selected={defaultCurrency === 'USD'}>USD ($)</option>
            <option value="EUR" selected={defaultCurrency === 'EUR'}>EUR (€)</option>
            <option value="GBP" selected={defaultCurrency === 'GBP'}>GBP (£)</option>
            <option value="CAD" selected={defaultCurrency === 'CAD'}>CAD ($)</option>
            <option value="AUD" selected={defaultCurrency === 'AUD'}>AUD ($)</option>
            <option value="JPY" selected={defaultCurrency === 'JPY'}>JPY (¥)</option>
            <option value="CHF" selected={defaultCurrency === 'CHF'}>CHF (Fr)</option>
            <option value="CNY" selected={defaultCurrency === 'CNY'}>CNY (¥)</option>
            <option value="INR" selected={defaultCurrency === 'INR'}>INR (₹)</option>
            <option value="MXN" selected={defaultCurrency === 'MXN'}>MXN ($)</option>
          </select>
          <p class="text-xs text-slate-500 mt-1">This will be used as the default currency for new trackers.</p>
        </div>
        <div id="preferences-success" class="text-sm text-green-600 hidden"></div>
        <div id="preferences-error" class="text-sm text-red-600 hidden"></div>
        <div class="flex justify-end">
          <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium">
            Save Preferences
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function setupForm(formId: string, action: string, successId: string, errorId: string) {
      const form = document.getElementById(formId);
      const successDiv = document.getElementById(successId);
      const errorDiv = document.getElementById(errorId);

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!(e.target instanceof HTMLFormElement)) return;
        
        if (successDiv) successDiv.classList.add('hidden');
        if (errorDiv) errorDiv.classList.add('hidden');

        const formData = new FormData(e.target);
        const payload: Record<string, any> = {};
        formData.forEach((value, key) => {
          payload[key] = value;
        });

        try {
          const res = await fetch('/api/rpc', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action, payload }),
          });
          const data = await res.json();
          if (data.success) {
            if (successDiv) {
              successDiv.textContent = 'Changes saved successfully!';
              successDiv.classList.remove('hidden');
            }
          } else {
            if (errorDiv) {
              errorDiv.textContent = data.error.message;
              errorDiv.classList.remove('hidden');
            }
          }
        } catch (err) {
          if (errorDiv) {
            errorDiv.textContent = 'An error occurred. Please try again.';
            errorDiv.classList.remove('hidden');
          }
        }
      });
    }

    setupForm('profile-form', 'user.updateProfile', 'profile-success', 'profile-error');
    setupForm('password-form', 'user.changePassword', 'password-success', 'password-error');
    setupForm('preferences-form', 'user.updatePreferences', 'preferences-success', 'preferences-error');
  </script>
</Layout>