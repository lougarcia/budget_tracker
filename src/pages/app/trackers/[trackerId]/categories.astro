---
import TrackerLayout from '../../../../layouts/TrackerLayout.astro';
import { trackers, categories, trackerMembers } from '../../../../db/schema';
import { eq, and, asc, inArray } from 'drizzle-orm';
import { requireTrackerAccess } from '../../../../lib/auth-guards';

const { trackerId } = Astro.params;
const user = Astro.locals.user!;
const db = Astro.locals.db;

const member = await requireTrackerAccess(db, user.id, trackerId!).catch(() => null);
if (!member) {
  return Astro.redirect('/app/trackers');
}

const [tracker] = await db.select().from(trackers).where(eq(trackers.id, trackerId!)).limit(1);
if (!tracker) {
  return Astro.redirect('/app/trackers');
}

const userMemberships = await db
  .select({ trackerId: trackerMembers.trackerId, role: trackerMembers.role })
  .from(trackerMembers)
  .where(eq(trackerMembers.userId, user.id));
const userTrackerIds = userMemberships.map(m => m.trackerId);
const userTrackers = userTrackerIds.length > 0
  ? await db.select().from(trackers).where(inArray(trackers.id, userTrackerIds))
  : [];
const userTrackersWithRole = userTrackers.map(t => {
  const membership = userMemberships.find(m => m.trackerId === t.id);
  return { id: t.id, name: t.name, role: membership?.role || 'owner', description: t.description };
});

const trackerCategories = await db
  .select()
  .from(categories)
  .where(eq(categories.trackerId, trackerId!))
  .orderBy(asc(categories.type), asc(categories.sortOrder), asc(categories.name));

const categoryOptions = trackerCategories.map((c) => ({ id: c.id, name: c.name, type: c.type }));

const incomeCategories = trackerCategories.filter((c: any) => c.type === 'income');
const expenseCategories = trackerCategories.filter((c: any) => c.type === 'expense');
---
<TrackerLayout title={`Categories — ${tracker.name}`} trackerId={trackerId!} trackerName={tracker.name} trackerRole={member.role} trackerDescription={tracker.description} currentPath="categories" categories={categoryOptions} userTrackers={userTrackersWithRole}>
  <div class="space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-bold text-slate-900">Categories</h1>
        </div>
        <p class="text-slate-600 text-sm mt-1">{trackerCategories.length} categories total</p>
      </div>
      <button id="add-category-btn" class="bg-indigo-600 text-white font-medium px-4 py-2 rounded-xl hover:bg-indigo-700 transition text-sm">
        + Add Category
      </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-200 bg-emerald-50">
          <h2 class="text-lg font-bold text-emerald-800">Income Categories ({incomeCategories.length})</h2>
        </div>
        {incomeCategories.length === 0 ? (
          <div class="p-8 text-center text-slate-500">
            <p class="text-sm">No income categories yet.</p>
          </div>
        ) : (
          <div class="divide-y divide-slate-100">
            {incomeCategories.map((cat: any) => (
              <div class="px-6 py-4 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  {cat.color && (
                    <div class="w-4 h-4 rounded-full" style={`background-color: ${cat.color}`}></div>
                  )}
                  <span class="font-semibold text-slate-900">{cat.name}</span>
                  {cat.icon && <span class="text-slate-400">{cat.icon}</span>}
                </div>
                <div class="flex items-center gap-2">
                  <button
                    onclick={`openEditModal('${cat.id}', '${cat.name}', '${cat.type}', '${cat.color || ''}', '${cat.icon || ''}')`}
                    class="px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-medium transition"
                  >
                    Edit
                  </button>
                  <button
                    onclick={`deleteCategory('${cat.id}', '${cat.name}')`}
                    class="px-3 py-1 bg-slate-100 hover:bg-rose-50 hover:text-rose-700 text-slate-700 rounded-lg text-xs font-medium transition"
                  >
                    Delete
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-200 bg-rose-50">
          <h2 class="text-lg font-bold text-rose-800">Expense Categories ({expenseCategories.length})</h2>
        </div>
        {expenseCategories.length === 0 ? (
          <div class="p-8 text-center text-slate-500">
            <p class="text-sm">No expense categories yet.</p>
          </div>
        ) : (
          <div class="divide-y divide-slate-100">
            {expenseCategories.map((cat: any) => (
              <div class="px-6 py-4 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  {cat.color && (
                    <div class="w-4 h-4 rounded-full" style={`background-color: ${cat.color}`}></div>
                  )}
                  <span class="font-semibold text-slate-900">{cat.name}</span>
                  {cat.icon && <span class="text-slate-400">{cat.icon}</span>}
                </div>
                <div class="flex items-center gap-2">
                  <button
                    onclick={`openEditModal('${cat.id}', '${cat.name}', '${cat.type}', '${cat.color || ''}', '${cat.icon || ''}')`}
                    class="px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-medium transition"
                  >
                    Edit
                  </button>
                  <button
                    onclick={`deleteCategory('${cat.id}', '${cat.name}')`}
                    class="px-3 py-1 bg-slate-100 hover:bg-rose-50 hover:text-rose-700 text-slate-700 rounded-lg text-xs font-medium transition"
                  >
                    Delete
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>

  <div id="category-modal" class="fixed inset-0 bg-black/50 hidden items-center justify-center p-4 z-50">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl">
      <h2 id="modal-title" class="text-xl font-bold text-slate-900 mb-4">Add Category</h2>
      <form id="category-form" class="space-y-4">
        <input type="hidden" id="modal-cat-id" />
        <div>
          <label for="cat-name" class="block text-sm font-medium text-slate-700 mb-1">Category Name</label>
          <input
            type="text"
            id="cat-name"
            name="name"
            required
            placeholder="e.g. Groceries"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          />
        </div>
        <div>
          <label for="cat-type" class="block text-sm font-medium text-slate-700 mb-1">Type</label>
          <select name="type" id="cat-type" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            <option value="expense">Expense</option>
            <option value="income">Income</option>
          </select>
        </div>
        <div>
          <label for="cat-color" class="block text-sm font-medium text-slate-700 mb-1">Color (Optional)</label>
          <input
            type="color"
            id="cat-color"
            name="color"
            class="w-full h-10 px-2 py-1 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          />
        </div>
        <div>
          <label for="cat-icon" class="block text-sm font-medium text-slate-700 mb-1">Icon (Optional)</label>
          <input
            type="text"
            id="cat-icon"
            name="icon"
            placeholder="e.g. 🛒"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          />
        </div>
        <div id="category-error" class="text-sm text-red-600 hidden" role="alert"></div>
        <div class="flex justify-end gap-3 pt-2">
          <button type="button" id="close-category-modal" class="px-4 py-2 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50 font-medium">Cancel</button>
          <button type="submit" id="submit-btn" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium">Save Category</button>
        </div>
      </form>
    </div>
  </div>

  <script define:vars={{ trackerId }}>
    function setupCategories() {
      const modal = document.getElementById('category-modal');
      const openBtn = document.getElementById('add-category-btn');
      const closeBtn = document.getElementById('close-category-modal');
      const form = document.getElementById('category-form');
      const errorDiv = document.getElementById('category-error');
      const modalTitle = document.getElementById('modal-title');
      const modalCatId = document.getElementById('modal-cat-id');
      const submitBtn = document.getElementById('submit-btn');

      let isEditing = false;

      openBtn?.addEventListener('click', () => {
        isEditing = false;
        if (modalTitle) modalTitle.textContent = 'Add Category';
        if (submitBtn) submitBtn.textContent = 'Save Category';
        if (modalCatId) modalCatId.value = '';
        form?.reset();
        modal?.classList.remove('hidden');
        modal?.classList.add('flex');
      });

      closeBtn?.addEventListener('click', () => {
        modal?.classList.add('hidden');
        modal?.classList.remove('flex');
      });

      window.openEditModal = (id, name, type, color, icon) => {
        isEditing = true;
        if (modalTitle) modalTitle.textContent = 'Edit Category';
        if (submitBtn) submitBtn.textContent = 'Update Category';
        if (modalCatId) modalCatId.value = id;
        const nameInput = document.getElementById('cat-name');
        const typeSelect = document.getElementById('cat-type');
        const colorInput = document.getElementById('cat-color');
        const iconInput = document.getElementById('cat-icon');
        if (nameInput) nameInput.value = name;
        if (typeSelect) typeSelect.value = type;
        if (colorInput) colorInput.value = color || '#000000';
        if (iconInput) iconInput.value = icon || '';
        modal?.classList.remove('hidden');
        modal?.classList.add('flex');
      };

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (errorDiv) errorDiv.classList.add('hidden');
        const formData = new FormData(form);

        const payload = {
          trackerId,
          name: formData.get('name'),
          type: formData.get('type'),
          color: formData.get('color') || null,
          icon: formData.get('icon') || null,
        };

        const action = isEditing ? 'category.update' : 'category.create';
        if (isEditing) {
          payload.id = modalCatId.value;
        }

        try {
          const res = await fetch('/api/rpc', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action, payload }),
          });
          const data = await res.json();
          if (data.success) {
            window.location.reload();
          } else {
            if (errorDiv) {
              errorDiv.textContent = data.error.message;
              errorDiv.classList.remove('hidden');
            }
          }
        } catch (err) {
          if (errorDiv) {
            errorDiv.textContent = 'Failed to save category';
            errorDiv.classList.remove('hidden');
          }
        }
      });

      window.deleteCategory = async (catId, catName) => {
        if (!confirm(`Are you sure you want to delete "${catName}"? This cannot be undone.`)) return;
        try {
          const res = await fetch('/api/rpc', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'category.delete', payload: { id: catId, trackerId } }),
          });
          const data = await res.json();
          if (data.success) {
            window.location.reload();
          } else {
            alert(data.error.message || 'Failed to delete category');
          }
        } catch (err) {
          alert('Failed to delete category');
        }
      };
    }

    document.addEventListener('astro:page-load', setupCategories);
  </script>
</TrackerLayout>