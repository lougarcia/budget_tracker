---
import TrackerLayout from '../../../../layouts/TrackerLayout.astro';
import { trackers, categories, transactions, trackerMembers } from '../../../../db/schema';
import { eq, and, desc, gte, lte } from 'drizzle-orm';
import { requireTrackerAccess } from '../../../../lib/auth-guards';
import { formatMoney } from '../../../../lib/money';

const { trackerId } = Astro.params;
const user = Astro.locals.user!;
const db = Astro.locals.db;

const member = await requireTrackerAccess(db, user.id, trackerId!).catch(() => null);
if (!member) {
  return Astro.redirect('/app/trackers');
}

const [tracker] = await db.select().from(trackers).where(eq(trackers.id, trackerId!)).limit(1);
if (!tracker) {
  return Astro.redirect('/app/trackers');
}

const url = new URL(Astro.request.url);
const now = new Date();
const year = parseInt(url.searchParams.get('year') || String(now.getFullYear()));
const month = parseInt(url.searchParams.get('month') || String(now.getMonth() + 1));

const startDate = `${year}-${String(month).padStart(2, '0')}-01`;
const lastDay = new Date(year, month, 0).getDate();
const endDate = `${year}-${String(month).padStart(2, '0')}-${String(lastDay).padStart(2, '0')}`;

const trackerCategories = await db
  .select()
  .from(categories)
  .where(eq(categories.trackerId, trackerId!));

const categoryOptions = trackerCategories.map((c) => ({ id: c.id, name: c.name, type: c.type }));

const monthTransactions = await db
  .select({
    id: transactions.id,
    type: transactions.type,
    amount: transactions.amount,
    transactionDate: transactions.transactionDate,
    merchant: transactions.merchant,
    description: transactions.description,
    categoryId: transactions.categoryId,
    categoryName: categories.name,
    paymentMethod: transactions.paymentMethod,
  })
  .from(transactions)
  .innerJoin(categories, eq(transactions.categoryId, categories.id))
  .where(
    and(
      eq(transactions.trackerId, trackerId!),
      gte(transactions.transactionDate, startDate),
      lte(transactions.transactionDate, endDate)
    )
  )
  .orderBy(desc(transactions.transactionDate));

let totalIncome = 0;
let totalExpenses = 0;

for (const tx of monthTransactions) {
  if (tx.type === 'income') {
    totalIncome += tx.amount;
  } else if (tx.type === 'expense') {
    totalExpenses += tx.amount;
  }
}

const netIncome = totalIncome - totalExpenses;
const savingsRate = totalIncome > 0 ? Math.max(0, netIncome / totalIncome) : 0;
---
<TrackerLayout
  title={tracker.name}
  trackerId={trackerId!}
  trackerName={tracker.name}
  trackerRole={member.role}
  trackerDescription={tracker.description}
  currentPath="dashboard"
  year={year}
  month={month}
  categories={categoryOptions}
>
  <div class="space-y-8">
    <div class="flex items-center justify-between bg-white px-6 py-4 rounded-xl border border-slate-200">
      <div class="flex items-center gap-2">
        <span class="text-sm font-medium text-slate-700">Period:</span>
        <select id="month-select" class="px-3 py-1.5 border border-slate-300 rounded-lg text-sm font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none">
          {Array.from({ length: 12 }, (_, i) => i + 1).map((m) => (
            <option value={m} selected={m === month}>
              {new Date(0, m - 1).toLocaleString('default', { month: 'long' })}
            </option>
          ))}
        </select>
        <select id="year-select" class="px-3 py-1.5 border border-slate-300 rounded-lg text-sm font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none">
          {[2024, 2025, 2026, 2027].map((y) => (
            <option value={y} selected={y === year}>{y}</option>
          ))}
        </select>
      </div>
      <div class="text-sm text-slate-500">
        Currency: <span class="font-semibold text-slate-700">{tracker.currency}</span>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" role="group" aria-label="Financial summary">
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm" role="region" aria-label="Total Income">
        <p class="text-sm font-medium text-slate-500">Total Income</p>
        <p class="text-2xl font-extrabold text-emerald-600 mt-2" aria-live="polite">{formatMoney(totalIncome, tracker.currency)}</p>
      </div>
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm" role="region" aria-label="Total Expenses">
        <p class="text-sm font-medium text-slate-500">Total Expenses</p>
        <p class="text-2xl font-extrabold text-rose-600 mt-2" aria-live="polite">{formatMoney(totalExpenses, tracker.currency)}</p>
      </div>
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm" role="region" aria-label="Net Income">
        <p class="text-sm font-medium text-slate-500">Net Income</p>
        <p class={`text-2xl font-extrabold mt-2 ${netIncome >= 0 ? 'text-indigo-600' : 'text-rose-600'}`} aria-live="polite">
          {formatMoney(netIncome, tracker.currency)}
        </p>
      </div>
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm" role="region" aria-label="Savings Rate">
        <p class="text-sm font-medium text-slate-500">Savings Rate</p>
        <p class="text-2xl font-extrabold text-slate-900 mt-2" aria-live="polite">{(savingsRate * 100).toFixed(1)}%</p>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
      <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center">
        <h2 class="text-lg font-bold text-slate-900">Recent Transactions</h2>
        <span class="text-sm text-slate-500">{monthTransactions.length} recorded this month</span>
      </div>
      {monthTransactions.length === 0 ? (
        <div class="p-12 text-center text-slate-500">
          <p class="text-base font-medium">No transactions recorded for this month.</p>
          <p class="text-sm mt-1">Click "+ Add Transaction" to get started.</p>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse" aria-label="Recent transactions">
            <thead>
              <tr class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200">
                <th scope="col" class="px-6 py-3">Date</th>
                <th scope="col" class="px-6 py-3">Merchant</th>
                <th scope="col" class="px-6 py-3">Category</th>
                <th scope="col" class="px-6 py-3">Type</th>
                <th scope="col" class="px-6 py-3 text-right">Amount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-sm">
              {monthTransactions.map((tx: any) => (
                <tr class="hover:bg-slate-50/50 transition">
                  <td class="px-6 py-4 text-slate-600 font-medium">{tx.transactionDate}</td>
                  <td class="px-6 py-4 text-slate-900 font-semibold">{tx.merchant}</td>
                  <td class="px-6 py-4">
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs font-medium rounded-full">{tx.categoryName}</span>
                  </td>
                  <td class="px-6 py-4">
                    <span class={`px-2 py-0.5 text-xs font-bold uppercase rounded-full ${tx.type === 'income' ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700'}`}>
                      {tx.type}
                    </span>
                  </td>
                  <td class={`px-6 py-4 text-right font-bold ${tx.type === 'income' ? 'text-emerald-600' : 'text-rose-600'}`}>
                    {tx.type === 'income' ? '+' : '-'}{formatMoney(tx.amount, tracker.currency)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

  <script define:vars={{ trackerId, year, month }}>
    function setupDashboard() {
      const monthSelect = document.getElementById('month-select');
      const yearSelect = document.getElementById('year-select');

      function updatePeriod() {
        const m = monthSelect.value;
        const y = yearSelect.value;
        window.location.href = `/app/trackers/${trackerId}?year=${y}&month=${m}`;
      }

      monthSelect?.addEventListener('change', updatePeriod);
      yearSelect?.addEventListener('change', updatePeriod);

      if (typeof gsap !== 'undefined') {
        gsap.from('.grid > div', {
          y: 20,
          opacity: 0,
          duration: 0.5,
          stagger: 0.1,
          ease: 'power2.out',
        });
      }
    }

    document.addEventListener('astro:page-load', setupDashboard);
  </script>
  <script>
    import gsap from 'gsap';
    (window as any).gsap = gsap;
  </script>
</TrackerLayout>
